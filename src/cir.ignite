// The fields of `Type` kind `tuple`.
type TupleType {
  elems: List<Type>
}

fn TupleType.from_json(value: Json, path: Text) -> Result<TupleType, ReadError> {
  let members = members_of(value, path, ["k", "elems"])?
  Ok(TupleType {
    elems = decode_list(required(members, "elems", path)?, path + ".elems", Type.from_json)?
  })
}

fn TupleType.to_json(value: TupleType) -> Json {
  var members: List<(Text, Json)> = [("k", Json.Str("tuple"))]
  members.push(("elems", Json.Array(value.elems.map(Type.to_json))))
  Json.Object(members)
}

// A named type declaration.
enum TypeDecl {
  Struct(StructTypeDecl),
  // A basic type given a name.
  Newtype(NewtypeTypeDecl),
  // A newtype whose values are exactly the declared variants.
  Enum(EnumTypeDecl),
  // Tagged variants, each carrying its own fields.
  Union(UnionTypeDecl)
}

fn TypeDecl.from_json(value: Json, path: Text) -> Result<TypeDecl, ReadError> = match kind_of(value, path)? {
  "struct" => Ok(TypeDecl.Struct(StructTypeDecl.from_json(value, path)?))
  "newtype" => Ok(TypeDecl.Newtype(NewtypeTypeDecl.from_json(value, path)?))
  "enum" => Ok(TypeDecl.Enum(EnumTypeDecl.from_json(value, path)?))
  "union" => Ok(TypeDecl.Union(UnionTypeDecl.from_json(value, path)?))
  other => refusal(path + ".k", "unknown kind `" + other + "` of TypeDecl")
}

fn TypeDecl.to_json(value: TypeDecl) -> Json = match value {
  TypeDecl.Struct(payload) => StructTypeDecl.to_json(payload)
  TypeDecl.Newtype(payload) => NewtypeTypeDecl.to_json(payload)
  TypeDecl.Enum(payload) => EnumTypeDecl.to_json(payload)
  TypeDecl.Union(payload) => UnionTypeDecl.to_json(payload)
}

// The fields of `TypeDecl` kind `struct`.
type StructTypeDecl {
  name: Text
  exported: Bool
  fields: List<Field>
  doc: Text
  pos: Text
}

fn StructTypeDecl.from_json(value: Json, path: Text) -> Result<StructTypeDecl, ReadError> {
  let members = members_of(value, path, ["k", "name", "exported", "fields", "doc", "pos"])?
  Ok(StructTypeDecl {
    name = decode_text(required(members, "name", path)?, path + ".name")?,
    exported = decode_bool(required(members, "exported", path)?, path + ".exported")?,
    fields = decode_list(required(members, "fields", path)?, path + ".fields", Field.from_json)?,
    doc = optional_text(members, "doc", path)?,
    pos = decode_text(required(members, "pos", path)?, path + ".pos")?
  })
}

fn StructTypeDecl.to_json(value: StructTypeDecl) -> Json {
  var members: List<(Text, Json)> = [("k", Json.Str("struct"))]
  members.push(("name", encode_text(value.name)))
  members.push(("exported", encode_bool(value.exported)))
  members.push(("fields", Json.Array(value.fields.map(Field.to_json))))
  if !value.doc.is_empty() {
    members.push(("doc", encode_text(value.doc)))
  }
  members.push(("pos", encode_text(value.pos)))
  Json.Object(members)
}

// The fields of `TypeDecl` kind `newtype`.
type NewtypeTypeDecl {
  name: Text
  exported: Bool
  under: Type
  doc: Text
  pos: Text
}

fn NewtypeTypeDecl.from_json(value: Json, path: Text) -> Result<NewtypeTypeDecl, ReadError> {
  let members = members_of(value, path, ["k", "name", "exported", "under", "doc", "pos"])?
  Ok(NewtypeTypeDecl {
    name = decode_text(required(members, "name", path)?, path + ".name")?,
    exported = decode_bool(required(members, "exported", path)?, path + ".exported")?,
    under = Type.from_json(required(members, "under", path)?, path + ".under")?,
    doc = optional_text(members, "doc", path)?,
    pos = decode_text(required(members, "pos", path)?, path + ".pos")?
  })
}

fn NewtypeTypeDecl.to_json(value: NewtypeTypeDecl) -> Json {
  var members: List<(Text, Json)> = [("k", Json.Str("newtype"))]
  members.push(("name", encode_text(value.name)))
  members.push(("exported", encode_bool(value.exported)))
  members.push(("under", Type.to_json(value.under)))
  if !value.doc.is_empty() {
    members.push(("doc", encode_text(value.doc)))
  }
  members.push(("pos", encode_text(value.pos)))
  Json.Object(members)
}

// The fields of `TypeDecl` kind `enum`.
type EnumTypeDecl {
  name: Text
  exported: Bool
  under: Type
  variants: List<Variant>
  doc: Text
  pos: Text
}

fn EnumTypeDecl.from_json(value: Json, path: Text) -> Result<EnumTypeDecl, ReadError> {
  let members = members_of(value, path, ["k", "name", "exported", "under", "variants", "doc", "pos"])?
  Ok(EnumTypeDecl {
    name = decode_text(required(members, "name", path)?, path + ".name")?,
    exported = decode_bool(required(members, "exported", path)?, path + ".exported")?,
    under = Type.from_json(required(members, "under", path)?, path + ".under")?,
    variants = decode_list(required(members, "variants", path)?, path + ".variants", Variant.from_json)?,
    doc = optional_text(members, "doc", path)?,
    pos = decode_text(required(members, "pos", path)?, path + ".pos")?
  })
}

fn EnumTypeDecl.to_json(value: EnumTypeDecl) -> Json {
  var members: List<(Text, Json)> = [("k", Json.Str("enum"))]
  members.push(("name", encode_text(value.name)))
  members.push(("exported", encode_bool(value.exported)))
  members.push(("under", Type.to_json(value.under)))
  members.push(("variants", Json.Array(value.variants.map(Variant.to_json))))
  if !value.doc.is_empty() {
    members.push(("doc", encode_text(value.doc)))
  }
  members.push(("pos", encode_text(value.pos)))
  Json.Object(members)
}

// The fields of `TypeDecl` kind `union`.
type UnionTypeDecl {
  name: Text
  exported: Bool
  variants: List<UnionVariant>
  doc: Text
  pos: Text
}

fn UnionTypeDecl.from_json(value: Json, path: Text) -> Result<UnionTypeDecl, ReadError> {
  let members = members_of(value, path, ["k", "name", "exported", "variants", "doc", "pos"])?
  Ok(UnionTypeDecl {
    name = decode_text(required(members, "name", path)?, path + ".name")?,
    exported = decode_bool(required(members, "exported", path)?, path + ".exported")?,
    variants = decode_list(required(members, "variants", path)?, path + ".variants", UnionVariant.from_json)?,
    doc = optional_text(members, "doc", path)?,
    pos = decode_text(required(members, "pos", path)?, path + ".pos")?
  })
}

fn UnionTypeDecl.to_json(value: UnionTypeDecl) -> Json {
  var members: List<(Text, Json)> = [("k", Json.Str("union"))]
  members.push(("name", encode_text(value.name)))
  members.push(("exported", encode_bool(value.exported)))
  members.push(("variants", Json.Array(value.variants.map(UnionVariant.to_json))))
  if !value.doc.is_empty() {
    members.push(("doc", encode_text(value.doc)))
  }
  members.push(("pos", encode_text(value.pos)))
  Json.Object(members)
}

type UnionVariant {
  name: Text
  fields: List<Field>
}

fn UnionVariant.from_json(value: Json, path: Text) -> Result<UnionVariant, ReadError> {
  let members = members_of(value, path, ["name", "fields"])?
  Ok(UnionVariant {
    name = decode_text(required(members, "name", path)?, path + ".name")?,
    fields = decode_list(required(members, "fields", path)?, path + ".fields", Field.from_json)?
  })
}

fn UnionVariant.to_json(value: UnionVariant) -> Json {
  var members: List<(Text, Json)> = []
  members.push(("name", encode_text(value.name)))
  members.push(("fields", Json.Array(value.fields.map(Field.to_json))))
  Json.Object(members)
}

type Variant {
  name: Text
  value: Expr
}

fn Variant.from_json(value: Json, path: Text) -> Result<Variant, ReadError> {
  let members = members_of(value, path, ["name", "value"])?
  Ok(Variant {
    name = decode_text(required(members, "name", path)?, path + ".name")?,
    value = Expr.from_json(required(members, "value", path)?, path + ".value")?
  })
}

fn Variant.to_json(value: Variant) -> Json {
  var members: List<(Text, Json)> = []
  members.push(("name", encode_text(value.name)))
  members.push(("value", Expr.to_json(value.value)))
  Json.Object(members)
}

// ---- reading and writing helpers ----------------------------------------------------------

// Why a document is not cir/1: the JSON path of the offending value (`$` is the document,
// `.name` a member, `[i]` an element) and the reason.
type ReadError {
  path: Text
  message: Text
}

fn describe(error: ReadError) -> Text = error.path + ": " + error.message

fn refusal<T>(path: Text, message: Text) -> Result<T, ReadError> = Err(ReadError { path = path, message = message })

fn has_name(names: List<Text>, name: Text) -> Bool {
  for n in names {
    if n == name {
      return true
    }
  }
  false
}

// The members of the object `value`; a member not in `known`, or one given twice, is refused.
fn members_of(value: Json, path: Text, known: List<Text>) -> Result<List<(Text, Json)>, ReadError> {
  let members = match value {
    Json.Object(members) => members
    _ => return refusal(path, "expected an object")
  }
  var seen: List<Text> = []
  for member in members {
    if !has_name(known, member.0) {
      return refusal(path + "." + member.0, "unknown field `" + member.0 + "`")
    }
    if has_name(seen, member.0) {
      return refusal(path + "." + member.0, "duplicate field `" + member.0 + "`")
    }
    seen.push(member.0)
  }
  Ok(members)
}

fn member(members: List<(Text, Json)>, name: Text) -> Option<Json> {
  for m in members {
    if m.0 == name {
      return Some(m.1)
    }
  }
  Option.None
}

fn required(members: List<(Text, Json)>, name: Text, path: Text) -> Result<Json, ReadError> = match member(members, name) {
  Some(value) => Ok(value)
  Option.None => refusal(path, "missing field `" + name + "`")
}

// The kind `k` of the tagged object `value`.
fn kind_of(value: Json, path: Text) -> Result<Text, ReadError> {
  let members = match value {
    Json.Object(members) => members
    _ => return refusal(path, "expected an object")
  }
  match member(members, "k") {
    Some(Json.Str(kind)) => Ok(kind)
    Some(_) => refusal(path + ".k", "expected a string")
    Option.None => refusal(path, "missing field `k`")
  }
}

fn decode_text(value: Json, path: Text) -> Result<Text, ReadError> = match value {
  Json.Str(text) => Ok(text)
  _ => refusal(path, "expected a string")
}

fn decode_bool(value: Json, path: Text) -> Result<Bool, ReadError> = match value {
  Json.Bool(b) => Ok(b)
  _ => refusal(path, "expected a boolean")
}

fn decode_list<T>(value: Json, path: Text, item: fn(Json, Text) -> Result<T, ReadError>) -> Result<List<T>, ReadError> {
  let items = match value {
    Json.Array(items) => items
    _ => return refusal(path, "expected an array")
  }
  var out: List<T> = []
  var i = 0
  for element in items {
    out.push(item(element, path + "[" + i.to_text() + "]")?)
    i = i + 1
  }
  Ok(out)
}

fn decode_nullable<T>(value: Json, path: Text, item: fn(Json, Text) -> Result<T, ReadError>) -> Result<Option<T>, ReadError> = match value {
  Json.Null => Ok(Option.None)
  present => Ok(Some(item(present, path)?))
}

// An optional string: `""` when absent.
fn optional_text(members: List<(Text, Json)>, name: Text, path: Text) -> Result<Text, ReadError> = match member(members, name) {
  Some(value) => decode_text(value, path + "." + name)
  Option.None => Ok("")
}

// An optional array: `[]` when absent.
fn optional_list<T>(members: List<(Text, Json)>, name: Text, path: Text, item: fn(Json, Text) -> Result<T, ReadError>) -> Result<List<T>, ReadError> = match member(members, name) {
  Some(value) => decode_list(value, path + "." + name, item)
  Option.None => Ok(List.empty())
}

// An optional nullable value: `None` when absent or null.
fn optional_nullable<T>(members: List<(Text, Json)>, name: Text, path: Text, item: fn(Json, Text) -> Result<T, ReadError>) -> Result<Option<T>, ReadError> = match member(members, name) {
  Some(value) => decode_nullable(value, path + "." + name, item)
  Option.None => Ok(Option.None)
}

fn encode_text(text: Text) -> Json = Json.Str(text)

fn encode_bool(b: Bool) -> Json = Json.Bool(b)

fn encode_nullable<T>(value: Option<T>, item: fn(T) -> Json) -> Json = match value {
  Some(present) => item(present)
  Option.None => Json.Null
}
