// A function or, with `recv`, a method.
type Func {
  name: Text
  exported: Bool
  recv: Option<Param>
  params: List<Param>
  results: List<Type>
  body: List<Stmt>
  doc: Text
  pos: Text
}

fn Func.from_json(value: Json, path: Text) -> Result<Func, ReadError> {
  let members = members_of(value, path, ["name", "exported", "recv", "params", "results", "body", "doc", "pos"])?
  Ok(Func {
    name = decode_text(required(members, "name", path)?, path + ".name")?,
    exported = decode_bool(required(members, "exported", path)?, path + ".exported")?,
    recv = optional_nullable(members, "recv", path, Param.from_json)?,
    params = decode_list(required(members, "params", path)?, path + ".params", Param.from_json)?,
    results = decode_list(required(members, "results", path)?, path + ".results", Type.from_json)?,
    body = decode_list(required(members, "body", path)?, path + ".body", Stmt.from_json)?,
    doc = optional_text(members, "doc", path)?,
    pos = decode_text(required(members, "pos", path)?, path + ".pos")?
  })
}

fn Func.to_json(value: Func) -> Json {
  var members: List<(Text, Json)> = []
  members.push(("name", encode_text(value.name)))
  members.push(("exported", encode_bool(value.exported)))
  match value.recv {
    Some(present) => members.push(("recv", Param.to_json(present)))
    Option.None => {}
  }
  members.push(("params", Json.Array(value.params.map(Param.to_json))))
  members.push(("results", Json.Array(value.results.map(Type.to_json))))
  members.push(("body", Json.Array(value.body.map(Stmt.to_json))))
  if !value.doc.is_empty() {
    members.push(("doc", encode_text(value.doc)))
  }
  members.push(("pos", encode_text(value.pos)))
  Json.Object(members)
}

// Integer width. `platform` is the source language's machine-word integer (Go `int`).
enum IntWidth {
  Platform,
  V8,
  V16,
  V32,
  V64
}

fn IntWidth.from_json(value: Json, path: Text) -> Result<IntWidth, ReadError> = match value {
  Json.Str("platform") => Ok(IntWidth.Platform)
  Json.Str("8") => Ok(IntWidth.V8)
  Json.Str("16") => Ok(IntWidth.V16)
  Json.Str("32") => Ok(IntWidth.V32)
  Json.Str("64") => Ok(IntWidth.V64)
  Json.Str(other) => refusal(path, "unknown value `" + other + "` of IntWidth")
  _ => refusal(path, "expected a string")
}

fn IntWidth.to_json(value: IntWidth) -> Json = match value {
  IntWidth.Platform => Json.Str("platform")
  IntWidth.V8 => Json.Str("8")
  IntWidth.V16 => Json.Str("16")
  IntWidth.V32 => Json.Str("32")
  IntWidth.V64 => Json.Str("64")
}

type Param {
  name: Text
  t: Type
}

fn Param.from_json(value: Json, path: Text) -> Result<Param, ReadError> {
  let members = members_of(value, path, ["name", "t"])?
  Ok(Param {
    name = decode_text(required(members, "name", path)?, path + ".name")?,
    t = Type.from_json(required(members, "t", path)?, path + ".t")?
  })
}

fn Param.to_json(value: Param) -> Json {
  var members: List<(Text, Json)> = []
  members.push(("name", encode_text(value.name)))
  members.push(("t", Type.to_json(value.t)))
  Json.Object(members)
}

type Reader {
