type Refusal {
  pos: Text
  what: Text
  reason: Text
}

fn Refusal.from_json(value: Json, path: Text) -> Result<Refusal, ReadError> {
  let members = members_of(value, path, ["pos", "what", "reason"])?
  Ok(Refusal {
    pos = decode_text(required(members, "pos", path)?, path + ".pos")?,
    what = decode_text(required(members, "what", path)?, path + ".what")?,
    reason = decode_text(required(members, "reason", path)?, path + ".reason")?
  })
}

fn Refusal.to_json(value: Refusal) -> Json {
  var members: List<(Text, Json)> = []
  members.push(("pos", encode_text(value.pos)))
  members.push(("what", encode_text(value.what)))
  members.push(("reason", encode_text(value.reason)))
  Json.Object(members)
}

// A statement.
enum Stmt {
  // `names := rhs`; a name `_` discards.
  Let(LetStmt),
  // `var name t`, the zero value.
  Var(VarStmt),
  // `lhs = rhs`, or `lhs <op> rhs` for a compound operator such as `+=`.
  Assign(AssignStmt),
  Incr(IncrStmt),
  Decr(DecrStmt),
  If(IfStmt),
  // `for key, val := range over { body }`; `_` for an unused name.
  ForRange(ForRangeStmt),
  // A `switch` on `tag`, or on `true` when `tag` is absent.
  Switch(SwitchStmt),
  Return(ReturnStmt),
  Expr(ExprStmt),
  // `chan <- x`.
  Send(SendStmt),
  // `name := map[index]`, running `then` (which ends in a return) when the key is absent.
  // `name` is not bound inside `then`.
  LookupElse(LookupElseStmt),
  // Source the reader kept verbatim, in `lang`, because cir/1 cannot express it.
  Foreign(ForeignStmt)
}

fn Stmt.from_json(value: Json, path: Text) -> Result<Stmt, ReadError> = match kind_of(value, path)? {
  "let" => Ok(Stmt.Let(LetStmt.from_json(value, path)?))
  "var" => Ok(Stmt.Var(VarStmt.from_json(value, path)?))
  "assign" => Ok(Stmt.Assign(AssignStmt.from_json(value, path)?))
  "incr" => Ok(Stmt.Incr(IncrStmt.from_json(value, path)?))
  "decr" => Ok(Stmt.Decr(DecrStmt.from_json(value, path)?))
  "if" => Ok(Stmt.If(IfStmt.from_json(value, path)?))
  "for_range" => Ok(Stmt.ForRange(ForRangeStmt.from_json(value, path)?))
  "switch" => Ok(Stmt.Switch(SwitchStmt.from_json(value, path)?))
  "return" => Ok(Stmt.Return(ReturnStmt.from_json(value, path)?))
  "expr" => Ok(Stmt.Expr(ExprStmt.from_json(value, path)?))
  "send" => Ok(Stmt.Send(SendStmt.from_json(value, path)?))
  "lookup_else" => Ok(Stmt.LookupElse(LookupElseStmt.from_json(value, path)?))
  "foreign" => Ok(Stmt.Foreign(ForeignStmt.from_json(value, path)?))
  other => refusal(path + ".k", "unknown kind `" + other + "` of Stmt")
}

fn Stmt.to_json(value: Stmt) -> Json = match value {
  Stmt.Let(payload) => LetStmt.to_json(payload)
  Stmt.Var(payload) => VarStmt.to_json(payload)
  Stmt.Assign(payload) => AssignStmt.to_json(payload)
  Stmt.Incr(payload) => IncrStmt.to_json(payload)
  Stmt.Decr(payload) => DecrStmt.to_json(payload)
  Stmt.If(payload) => IfStmt.to_json(payload)
  Stmt.ForRange(payload) => ForRangeStmt.to_json(payload)
  Stmt.Switch(payload) => SwitchStmt.to_json(payload)
  Stmt.Return(payload) => ReturnStmt.to_json(payload)
  Stmt.Expr(payload) => ExprStmt.to_json(payload)
  Stmt.Send(payload) => SendStmt.to_json(payload)
  Stmt.LookupElse(payload) => LookupElseStmt.to_json(payload)
  Stmt.Foreign(payload) => ForeignStmt.to_json(payload)
}

// The fields of `Stmt` kind `let`.
type LetStmt {
  names: List<Text>
  rhs: List<Expr>
  pos: Text
}

fn LetStmt.from_json(value: Json, path: Text) -> Result<LetStmt, ReadError> {
  let members = members_of(value, path, ["k", "names", "rhs", "pos"])?
  Ok(LetStmt {
    names = decode_list(required(members, "names", path)?, path + ".names", decode_text)?,
    rhs = decode_list(required(members, "rhs", path)?, path + ".rhs", Expr.from_json)?,
    pos = decode_text(required(members, "pos", path)?, path + ".pos")?
  })
}

fn LetStmt.to_json(value: LetStmt) -> Json {
  var members: List<(Text, Json)> = [("k", Json.Str("let"))]
  members.push(("names", Json.Array(value.names.map(encode_text))))
  members.push(("rhs", Json.Array(value.rhs.map(Expr.to_json))))
  members.push(("pos", encode_text(value.pos)))
  Json.Object(members)
}

