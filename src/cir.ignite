// One source module: a Go package, a Rust crate module, a Java compilation unit set.
type CirModule {
  format: Text
  name: Text
  reader: Reader
  doc: Text
  types: List<TypeDecl>
  consts: List<ConstDecl>
  errors: List<ErrorVar>
  funcs: List<Func>
  layout: List<Text>
  facts: Option<Facts>
  refusals: List<Refusal>
}

fn CirModule.from_json(value: Json, path: Text) -> Result<CirModule, ReadError> {
  let members = members_of(value, path, ["format", "name", "reader", "doc", "types", "consts", "errors", "funcs", "layout", "facts", "refusals"])?
  Ok(CirModule {
    format = decode_text(required(members, "format", path)?, path + ".format")?,
    name = decode_text(required(members, "name", path)?, path + ".name")?,
    reader = Reader.from_json(required(members, "reader", path)?, path + ".reader")?,
    doc = optional_text(members, "doc", path)?,
    types = decode_list(required(members, "types", path)?, path + ".types", TypeDecl.from_json)?,
    consts = optional_list(members, "consts", path, ConstDecl.from_json)?,
    errors = optional_list(members, "errors", path, ErrorVar.from_json)?,
    funcs = decode_list(required(members, "funcs", path)?, path + ".funcs", Func.from_json)?,
    layout = decode_list(required(members, "layout", path)?, path + ".layout", decode_text)?,
    facts = optional_nullable(members, "facts", path, Facts.from_json)?,
    refusals = optional_list(members, "refusals", path, Refusal.from_json)?
  })
}

fn CirModule.to_json(value: CirModule) -> Json {
  var members: List<(Text, Json)> = []
  members.push(("format", encode_text(value.format)))
  members.push(("name", encode_text(value.name)))
  members.push(("reader", Reader.to_json(value.reader)))
  if !value.doc.is_empty() {
    members.push(("doc", encode_text(value.doc)))
  }
  members.push(("types", Json.Array(value.types.map(TypeDecl.to_json))))
  if !value.consts.is_empty() {
    members.push(("consts", Json.Array(value.consts.map(ConstDecl.to_json))))
  }
  if !value.errors.is_empty() {
    members.push(("errors", Json.Array(value.errors.map(ErrorVar.to_json))))
  }
  members.push(("funcs", Json.Array(value.funcs.map(Func.to_json))))
  members.push(("layout", Json.Array(value.layout.map(encode_text))))
  match value.facts {
    Some(present) => members.push(("facts", Facts.to_json(present)))
    Option.None => {}
  }
  if !value.refusals.is_empty() {
    members.push(("refusals", Json.Array(value.refusals.map(Refusal.to_json))))
  }
  Json.Object(members)
}

