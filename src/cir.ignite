  // A sentinel error.
  Errvar(ErrvarExpr),
  Field(FieldExpr),
  Index(IndexExpr),
  // A call of a module function.
  Call(CallExpr),
  Method(MethodExpr),
  Binop(BinopExpr),
  // `!`, `-`, `+`, `^` (bitwise complement), `<-` (channel receive), `*` (dereference) or `&`
  // (reference).
  Unop(UnopExpr),
  Struct(StructExpr),
  // A conversion to the named type `name`.
  Conv(ConvExpr),
  // An empty map or slice.
  Make(MakeExpr),
  Zero(ZeroExpr),
  // `sprintf`, `errorf`, `println`, `append` or `len`.
  Intrinsic(IntrinsicExpr),
  // A value of an error struct used where an error is expected.
  ToError(ToErrorExpr)
}

