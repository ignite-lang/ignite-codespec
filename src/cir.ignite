  members.push(("lhs", Json.Array(value.lhs.map(Expr.to_json))))
  members.push(("rhs", Json.Array(value.rhs.map(Expr.to_json))))
  members.push(("pos", encode_text(value.pos)))
  Json.Object(members)
}

