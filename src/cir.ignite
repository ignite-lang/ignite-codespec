// The fields of `Stmt` kind `foreign`.
type ForeignStmt {
  lang: Text
  src: Text
  reason: Text
  pos: Text
}

fn ForeignStmt.from_json(value: Json, path: Text) -> Result<ForeignStmt, ReadError> {
  let members = members_of(value, path, ["k", "lang", "src", "reason", "pos"])?
  Ok(ForeignStmt {
    lang = decode_text(required(members, "lang", path)?, path + ".lang")?,
    src = decode_text(required(members, "src", path)?, path + ".src")?,
    reason = decode_text(required(members, "reason", path)?, path + ".reason")?,
    pos = decode_text(required(members, "pos", path)?, path + ".pos")?
  })
}

fn ForeignStmt.to_json(value: ForeignStmt) -> Json {
  var members: List<(Text, Json)> = [("k", Json.Str("foreign"))]
  members.push(("lang", encode_text(value.lang)))
  members.push(("src", encode_text(value.src)))
  members.push(("reason", encode_text(value.reason)))
  members.push(("pos", encode_text(value.pos)))
  Json.Object(members)
}

// A type expression.
enum Type {
  Int(IntType),
  Bool,
  String,
  // The source language's error type (Go `error`).
  Error,
  // The top type (Go `any`).
  Any,
  Unit,
  // A type the module declares.
  Named(NamedType),
  // A reference to `elem`.
  Ptr(PtrType),
  Slice(SliceType),
  Map(MapType),
  Chan(ChanType),
  Tuple(TupleType)
}

fn Type.from_json(value: Json, path: Text) -> Result<Type, ReadError> = match kind_of(value, path)? {
  "int" => Ok(Type.Int(IntType.from_json(value, path)?))
  "bool" => {
    members_of(value, path, ["k"])?
    Ok(Type.Bool)
  }
  "string" => {
    members_of(value, path, ["k"])?
    Ok(Type.String)
  }
  "error" => {
    members_of(value, path, ["k"])?
    Ok(Type.Error)
  }
  "any" => {
    members_of(value, path, ["k"])?
    Ok(Type.Any)
  }
  "unit" => {
    members_of(value, path, ["k"])?
    Ok(Type.Unit)
  }
  "named" => Ok(Type.Named(NamedType.from_json(value, path)?))
  "ptr" => Ok(Type.Ptr(PtrType.from_json(value, path)?))
  "slice" => Ok(Type.Slice(SliceType.from_json(value, path)?))
  "map" => Ok(Type.Map(MapType.from_json(value, path)?))
  "chan" => Ok(Type.Chan(ChanType.from_json(value, path)?))
  "tuple" => Ok(Type.Tuple(TupleType.from_json(value, path)?))
  other => refusal(path + ".k", "unknown kind `" + other + "` of Type")
}

fn Type.to_json(value: Type) -> Json = match value {
  Type.Int(payload) => IntType.to_json(payload)
  Type.Bool => Json.Object([("k", Json.Str("bool"))])
  Type.String => Json.Object([("k", Json.Str("string"))])
  Type.Error => Json.Object([("k", Json.Str("error"))])
  Type.Any => Json.Object([("k", Json.Str("any"))])
  Type.Unit => Json.Object([("k", Json.Str("unit"))])
  Type.Named(payload) => NamedType.to_json(payload)
  Type.Ptr(payload) => PtrType.to_json(payload)
  Type.Slice(payload) => SliceType.to_json(payload)
  Type.Map(payload) => MapType.to_json(payload)
  Type.Chan(payload) => ChanType.to_json(payload)
  Type.Tuple(payload) => TupleType.to_json(payload)
}

// The fields of `Type` kind `int`.
type IntType {
  width: IntWidth
  signed: Bool
}

fn IntType.from_json(value: Json, path: Text) -> Result<IntType, ReadError> {
  let members = members_of(value, path, ["k", "width", "signed"])?
  Ok(IntType {
    width = IntWidth.from_json(required(members, "width", path)?, path + ".width")?,
    signed = decode_bool(required(members, "signed", path)?, path + ".signed")?
  })
}

fn IntType.to_json(value: IntType) -> Json {
  var members: List<(Text, Json)> = [("k", Json.Str("int"))]
  members.push(("width", IntWidth.to_json(value.width)))
  members.push(("signed", encode_bool(value.signed)))
  Json.Object(members)
}

// The fields of `Type` kind `named`.
type NamedType {
  name: Text
}

fn NamedType.from_json(value: Json, path: Text) -> Result<NamedType, ReadError> {
  let members = members_of(value, path, ["k", "name"])?
  Ok(NamedType {
    name = decode_text(required(members, "name", path)?, path + ".name")?
  })
}

fn NamedType.to_json(value: NamedType) -> Json {
  var members: List<(Text, Json)> = [("k", Json.Str("named"))]
  members.push(("name", encode_text(value.name)))
  Json.Object(members)
}

// The fields of `Type` kind `ptr`.
type PtrType {
