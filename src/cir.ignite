}

fn IfStmt.from_json(value: Json, path: Text) -> Result<IfStmt, ReadError> {
  let members = members_of(value, path, ["k", "cond", "then", "else", "pos"])?
  Ok(IfStmt {
    cond = Expr.from_json(required(members, "cond", path)?, path + ".cond")?,
    then = decode_list(required(members, "then", path)?, path + ".then", Stmt.from_json)?,
    else_ = optional_list(members, "else", path, Stmt.from_json)?,
    pos = decode_text(required(members, "pos", path)?, path + ".pos")?
  })
}

fn IfStmt.to_json(value: IfStmt) -> Json {
  var members: List<(Text, Json)> = [("k", Json.Str("if"))]
  members.push(("cond", Expr.to_json(value.cond)))
  members.push(("then", Json.Array(value.then.map(Stmt.to_json))))
  if !value.else_.is_empty() {
    members.push(("else", Json.Array(value.else_.map(Stmt.to_json))))
  }
  members.push(("pos", encode_text(value.pos)))
  Json.Object(members)
}

