  dir: ChanDir
}

fn ChanType.from_json(value: Json, path: Text) -> Result<ChanType, ReadError> {
  let members = members_of(value, path, ["k", "elem", "dir"])?
  Ok(ChanType {
    elem = Type.from_json(required(members, "elem", path)?, path + ".elem")?,
    dir = ChanDir.from_json(required(members, "dir", path)?, path + ".dir")?
  })
}

fn ChanType.to_json(value: ChanType) -> Json {
