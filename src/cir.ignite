// Whole-module facts. Writers read these instead of deciding anything themselves.
type Facts {
  shared: List<Text>
  messages: List<Text>
  comma_ok: List<Text>
  fallible: List<Text>
  read_only: List<Text>
  displays: List<Text>
  unordered_iteration: List<Text>
}

fn Facts.from_json(value: Json, path: Text) -> Result<Facts, ReadError> {
  let members = members_of(value, path, ["shared", "messages", "comma_ok", "fallible", "read_only", "displays", "unordered_iteration"])?
  Ok(Facts {
    shared = decode_list(required(members, "shared", path)?, path + ".shared", decode_text)?,
    messages = optional_list(members, "messages", path, decode_text)?,
    comma_ok = optional_list(members, "comma_ok", path, decode_text)?,
    fallible = optional_list(members, "fallible", path, decode_text)?,
    read_only = optional_list(members, "read_only", path, decode_text)?,
    displays = optional_list(members, "displays", path, decode_text)?,
    unordered_iteration = optional_list(members, "unordered_iteration", path, decode_text)?
  })
}

fn Facts.to_json(value: Facts) -> Json {
  var members: List<(Text, Json)> = []
  members.push(("shared", Json.Array(value.shared.map(encode_text))))
  if !value.messages.is_empty() {
    members.push(("messages", Json.Array(value.messages.map(encode_text))))
  }
  if !value.comma_ok.is_empty() {
    members.push(("comma_ok", Json.Array(value.comma_ok.map(encode_text))))
  }
  if !value.fallible.is_empty() {
    members.push(("fallible", Json.Array(value.fallible.map(encode_text))))
  }
  if !value.read_only.is_empty() {
    members.push(("read_only", Json.Array(value.read_only.map(encode_text))))
  }
  if !value.displays.is_empty() {
    members.push(("displays", Json.Array(value.displays.map(encode_text))))
  }
  if !value.unordered_iteration.is_empty() {
    members.push(("unordered_iteration", Json.Array(value.unordered_iteration.map(encode_text))))
  }
  Json.Object(members)
}

type Field {
  name: Text
  t: Type
}

fn Field.from_json(value: Json, path: Text) -> Result<Field, ReadError> {
  let members = members_of(value, path, ["name", "t"])?
  Ok(Field {
    name = decode_text(required(members, "name", path)?, path + ".name")?,
    t = Type.from_json(required(members, "t", path)?, path + ".t")?
  })
}

fn Field.to_json(value: Field) -> Json {
  var members: List<(Text, Json)> = []
  members.push(("name", encode_text(value.name)))
  members.push(("t", Type.to_json(value.t)))
  Json.Object(members)
}

type FieldInit {
  name: Text
  value: Expr
}

fn FieldInit.from_json(value: Json, path: Text) -> Result<FieldInit, ReadError> {
  let members = members_of(value, path, ["name", "value"])?
  Ok(FieldInit {
    name = decode_text(required(members, "name", path)?, path + ".name")?,
    value = Expr.from_json(required(members, "value", path)?, path + ".value")?
  })
}

fn FieldInit.to_json(value: FieldInit) -> Json {
