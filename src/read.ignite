test const STMTS_SRC: Text = r##"package snip.stmts

enum Color {
  Red
  Green
  Blue
}

fn steps(start: Int, items: List<Int>, table: Map<Text, Int>) -> Int {
  let a = start
  var n = a
  n = n + 1
  n = n - 1
  n = n * 2
  if n > 3 {
    n = 0
  } else if n < 0 {
    return 1
  } else {
    n = 2
  }
  for item in items {
    n = n + item
  }
  for (key, value) in table {
    n = n - value
  }
  bump(n)
  n
}

fn bump(n: Int) {}

fn name(c: Color) -> Text = match c {
  Green | Blue => "other"
  Red => "red"
}

fn pick(c: Color) -> Int = match c {
  Red => 1
  _ => 2
}
"##

