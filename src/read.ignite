test const EXPRS_SRC: Text = r##"package snip.exprs

type Box {
  width: Int
  label: Text
}

const SIZE: Int = 3

enum Color {
  Red
  Green
}

fn Box.area(b: Box, scale: Int) -> Int = b.width * scale

fn build(items: List<Box>, flag: Bool) -> Box {
  var all: List<Box> = []
  var table: Map<Text, Int> = Map.empty()
  let first = Box { width = SIZE, label = "a\"b" }
  let second = Box { label = "w={first.width}", ..first }
  all.push(second)
  table.put(second.label, items.len())
  let c = Red
  let big = !flag && -first.width < Box.area(first, 2)
  let picked = items[0]
  first
