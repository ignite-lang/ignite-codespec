test const FOREIGN_SRC: Text = r##"package snip.foreign

fn count(n: Int) -> Int {
  var i = 0
  while i < n {
    i = i + 1
  }
  i
}

fn first<T>(xs: List<T>) -> T = xs[0]

test "count counts" {
  assert count(2) == 2
}

const TWICE: Int = 2 * 2

fn twice() -> Int = TWICE
"##

