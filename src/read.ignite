test const RESULTS_SRC: Text = r##"package snip.results

enum Error {
  NotFound
  Msg(Text)
}

fn Error.text(e: Error) -> Text = match e {
  NotFound => "not found"
  Msg(text) => text
}

fn find(table: Map<Text, Int>, key: Text) -> Result<Int, Error> {
  let v = match table.get(key) {
    Some(v) => v
    None => {
      return Err(NotFound)
    }
  }
  if v < 0 {
    return Err(Msg("negative " + key))
  }
  Ok(v)
}

fn lookup(key: Text) -> Option<Int> {
  if key == "" {
    return None
  }
  Some(1)
}

fn entry(table: Map<Text, Int>, key: Text) -> Option<Int> = table.get(key)
"##

