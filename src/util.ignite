package codespec.util

// Text and list helpers both adapters use, imported by `read.ignite` and `write.ignite`.

// Whether `names` holds `name`.
fn has(names: List<Text>, name: Text) -> Bool {
  for n in names {
    if n == name {
      return true
    }
  }
  false
}

// The bytes `start` to `end` of `text`.
fn cut(text: Text, start: Int, end: Int) -> Text = text.to_bytes().slice(start, end).to_text()
