package valuesdriver

import valuesdriver.values.{alias_list, alias_map, param_map, record_map, arm_wild, arm_bind}

// The harness driver of the Ignite original: reads and ignores the trace, prints one line per
// case of `values.ignite` (its sibling through the link `values.ignite` beside this file).

type Driver {
  executable: Text
}

fn Driver.main(self: Driver) -> Result<Unit, IoError> {
  read_all()?
  let out = [
    "alias_list {alias_list()}",
    "alias_map {alias_map()}",
    "param_map {param_map()}",
    "record_map {record_map()}",
    "arm_wild {arm_wild(1)}",
    "arm_bind {arm_bind(1)}"
  ]
  Stdout.write_all(out.map(|l| l + "\n").join("").to_bytes())
}

fn read_all() -> Result<Bytes, IoError> requires [stdin.read] {
  var data = Bytes.empty()
  loop {
    match Stdin.read(65536)? {
      Eof => return Ok(data)
      Data(more) => data.append(more)
    }
  }
}

system Harness {
  component driver: Driver {
    executable = "values-ignite"
  }
}
