package buildsdriver.builds

// Adversary cases of `codespec-read-ignite` (story ignite-reader): Ignite programs the reader
// reads without a refusal whose cir/1 module Go once could not build. The harness of this
// example runs this file and the Go that `codespec write --lang go` writes from the reader's
// document; the inline test pins Ignite's values. The cases the reader now refuses (a `let`
// shadowing one of its block, `==` on a record holding a list) moved to
// `examples/reader-values/source/values.ignite`, whose document holds their refusals.

enum Color {
  Red
  Green
}

// `len` of a text, list or map: cir/1's `int` is Go's `int`, as `len` is.
fn size(xs: List<Int>) -> Int = xs.len()

// An exhaustive `match` as a function's last expression: no arm is missing, so nothing follows.
fn name(c: Color) -> Text = match c {
  Red => "red"
  Green => "green"
}

test "the values Ignite gives" {
  assert size([1, 2, 3]) == 3
  assert name(Green) == "green"
}
